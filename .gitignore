# ── Python: erzeugte Bytecode-Dateien und Caches ───────────────────────────
# Diese Dateien entstehen beim Ausfuehren automatisch und gehoeren nicht ins Repo.
__pycache__/
*.pyc
*.pyo

# ── Persoenlicher Spielstand ───────────────────────────────────────────────
# Der Spielstand ist individuell pro Spielerin/Spieler und wird neu erzeugt.
spielstand.json
spielstand.json.tmp

# ── Persoenliche Einstellungen (Lautstaerke, Grafik, FPS) ────────────────────
# Das Einstellungsmenue schreibt eigene Werte - gehoeren nicht ins Repo.
einstellungen.json
einstellungen.json.tmp

# ── Persoenliche Statistik (Gebaeude ueber alle Partien, Spielzeit) ────────
statistik.json
statistik.json.tmp

# ── Editor-, System- und Hilfsdateien ──────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
# Temporaere Hilfs- und Testskripte aus dem Unterricht (nur lokal noetig)
Temp/
# Nicht spielrelevante Dateien (ehemals Temp/, Altlasten) — nur lokal
unnoetig/

# ── Virtuelle Umgebungen ───────────────────────────────────────────────────
.venv/
venv/
